{
  "expo": {
    "name": "openmesa0",
    "slug": "openmesa0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.jhonnysk.openmesa0"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "O OpenMesa precisa de acesso à câmera para escanear QR Codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class com.google.mlkit.** { *; }\n-keep class expo.modules.camera.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9ff278ac-e932-4f8d-8bca-dc1c3806d38e"
      }
    },
    "owner": "OpenMesaTeam"
  }
}
